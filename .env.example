# Copy to .env.local and fill in. Never commit .env.local.

# --- Sign-in (Auth.js) ---
# Random secret that encrypts the session cookie. Generate one with: npx auth secret
AUTH_SECRET=""
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# The Google accounts allowed to sign in. If empty, nobody can sign in.
# One Gmail address, or several separated by commas. Everyone listed shares the same data.
ALLOWED_EMAIL=""

# --- Database (from slice 4) ---
# Neon Postgres connection string (Neon console → Connect → "Pooled connection").
DATABASE_URL=""
